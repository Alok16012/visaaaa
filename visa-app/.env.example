# Supabase Configuration
# Get these values from your Supabase project settings (Settings -> API).
#
# Both are read only on the server, by src/lib/supabaseAdmin.ts. Do NOT add the
# NEXT_PUBLIC_ prefix to the service role key: that would inline it into the
# JavaScript bundle and hand every visitor full access to the database.

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
